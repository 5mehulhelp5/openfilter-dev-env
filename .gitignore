# This repository versions only the environment definition, setup scripts and Playwright tests.
# The Magento installation itself (created by bin/setup) is ignored.
/*
!/.gitignore
!/.env.example
!/admin.env.example
!/.warden/
!/README.md
!/LICENSE
!/bin/
/bin/*
!/bin/setup
!/bin/install-hyva
!/bin/install-modules
!/bin/fixture-data
!/bin/after-hours
!/bin/install-hyva15
!/playwright/
/playwright/node_modules/
/playwright/test-results/
/playwright/playwright-report/
/playwright/.auth/
!/docs/
!/bench/
!/modules/
/modules/*
!/modules/*.md
!/ci/
# Fixture-only Magento code: the theme registry module and the RTL child theme (the Hyvä 1.5.2 copy is downloaded).
!/app/
/app/*
!/app/code/
/app/code/*
!/app/code/OpenFilterFixture/
!/app/design/
/app/design/*
!/app/design/frontend/
/app/design/frontend/*
!/app/design/frontend/OpenFilterFixture/
/app/design/frontend/OpenFilterFixture/hyva-1-5-2/
!/.github/
playwright/lighthouse-report/
